#version 460
// Post-process resolve: temporal anti-aliasing plus the Sun's glare, in one dispatch.
//
// TAA: the scene is rendered with a sub-pixel jitter each frame; here every pixel is reprojected into the
// previous frame through the depth buffer (or as a pure direction for the sky) and blended with the history,
// clamped to the current frame's 3x3 neighbourhood so moving things do not smear. Edges, crater rims,
// truss work and ring gaps converge to a stable, anti-aliased result over a few frames.
//
// Glare: a soft halo and faint streaks around the Sun, weighted by how much of the solar disc is unoccluded
// (depth taps across the disc) and fading as the Sun leaves the frame.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D uHdr;      // this frame, jittered
layout(set = 0, binding = 1) uniform sampler2D uDepth;    // reversed, 0 = infinity
layout(set = 0, binding = 2) uniform sampler2D uHistory;  // last frame's resolve
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D uOut;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D uHistoryOut;

layout(push_constant) uniform PushConstants {
    mat4 prevViewProj; // last frame, unjittered
    mat4 viewProj;     // this frame, unjittered
    vec4 camRight, camUp, camForward;
    vec4 params;   // x tan(fov/2), y aspect, z near plane, w history blend (0 = no history)
    vec4 camDelta; // xyz camera movement since last frame (world), w 1 when a history frame exists
    vec4 sun;      // xyz camera-relative Sun position, w Sun radius (world)
    vec4 glare;    // x strength, y jitter u, z jitter v, w motion blur amount
} pc;

vec3 viewRay(vec2 uv) {
    vec2 ndc = uv * 2.0 - 1.0; // Vulkan: y down
    return normalize(pc.camForward.xyz + ndc.x * pc.params.x * pc.params.y * pc.camRight.xyz - ndc.y * pc.params.x * pc.camUp.xyz);
}

// Smooth periodic noise around a circle: `cells` values over a full turn, wrapping seamlessly.
float angHash(float i, float seed) { return fract(sin(i * 12.9898 + seed * 78.233) * 43758.5453); }
float angNoise(float a, float cells, float seed) {
    float x = (a / 6.2831853 + 0.5) * cells;
    float i = floor(x), f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(angHash(mod(i, cells), seed), angHash(mod(i + 1.0, cells), seed), f);
}

void main() {
    ivec2 size = imageSize(uOut);
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= size.x || gid.y >= size.y) return;
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(gid) + 0.5) * texel;

    // The jittered render is sampled at its true (unjittered) pixel centre.
    vec2 uvJ = uv + pc.glare.yz;
    vec3 current = texture(uHdr, uvJ).rgb;

    // Neighbourhood bounds for clamping the history.
    vec3 lo = current, hi = current;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            vec3 c = texture(uHdr, uvJ + vec2(x, y) * texel).rgb;
            lo = min(lo, c);
            hi = max(hi, c);
        }

    // Reproject.
    float d = texture(uDepth, uvJ).r;
    vec3 dir = viewRay(uv);
    vec4 prevClip;
    if (d <= 0.0) {
        prevClip = pc.prevViewProj * vec4(dir, 0.0); // infinitely far: direction only
    } else {
        // Depth is near / (distance along the forward axis), so scale by the ray's forward component.
        float zView = pc.params.z / d;
        vec3 p = dir * (zView / max(dot(dir, pc.camForward.xyz), 1e-4)) + pc.camDelta.xyz;
        prevClip = pc.prevViewProj * vec4(p, 1.0);
    }
    vec3 color = current;
    float blend = pc.params.w;
    if (prevClip.w > 1e-30) {
        // Motion blur along the screen-space movement since the last frame (capped): what sells speed.
        vec2 prevUv0 = prevClip.xy / prevClip.w * 0.5 + 0.5;
        vec2 vel = (uv - prevUv0) * vec2(size);
        float len = length(vel);
        if (len > 1.5 && pc.glare.w > 0.0) {
            vec2 step = vel / len * min(len, 28.0) / vec2(size) * pc.glare.w;
            vec3 acc = vec3(0.0);
            for (int i = 0; i < 8; ++i) {
                float f = (float(i) + 0.5) / 8.0 - 0.5;
                acc += texture(uHdr, uvJ + step * f).rgb;
            }
            current = acc / 8.0;
            color = current;
        }
    }
    if (blend > 0.0 && prevClip.w > 1e-30) {
        vec2 prevUv = prevClip.xy / prevClip.w * 0.5 + 0.5;
        if (all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThanEqual(prevUv, vec2(1.0)))) {
            vec3 hist = texture(uHistory, prevUv).rgb;
            // Clamp with a little slack so bright stars keep their glow between frames.
            vec3 slack = (hi - lo) * 0.25 + 1e-4;
            hist = clamp(hist, lo - slack, hi + slack);
            color = mix(current, hist, blend);
        }
    }
    // ---- Sun glare -------------------------------------------------------------------------
    // The visible fraction of the solar disc is smoothed over time (kept in the history alpha), so
    // a sunrise over a limb brightens steadily instead of flickering as depth taps flip.
    vec3 resolved = color;
    float visPrev = pc.camDelta.w > 0.0 ? texture(uHistory, uv).a : -1.0; // w: a history exists
    float visOut = 0.0;
    if (pc.glare.x > 0.0) {
        vec4 sc = pc.viewProj * vec4(pc.sun.xyz, 1.0);
        if (sc.w > 0.0) {
            vec2 sunUv = sc.xy / sc.w * 0.5 + 0.5;
            // The depth buffer is always jittered, even when the colour arrives resolved (DLSS): the taps
            // follow the depth's own jitter, or the visible fraction flips frame to frame and the glare pulses.
            vec2 depthJ = vec2(pc.camRight.w, pc.camUp.w);
            vec2 sunUvJ = sunUv + depthJ; // where the jittered depth buffer has the Sun
            float sunDist = length(pc.sun.xyz);
            float radiusNdc = pc.sun.w / max(sunDist, 1e-30) / pc.params.x; // in units of the half-height
            float sunDepth = pc.params.z / sunDist;
            // Visible fraction of the disc: depth taps across it (anything nearer hides that part).
            float vis = 0.0;
            const int TAPS = 12;
            for (int i = 0; i < TAPS; ++i) {
                float a = 6.2831853 * float(i) / float(TAPS);
                float r = (i % 2 == 0) ? 0.4 : 0.85;
                vec2 tapUv = sunUvJ + vec2(cos(a) / pc.params.y, sin(a)) * radiusNdc * 0.5 * r;
                if (any(lessThan(tapUv, vec2(0.0))) || any(greaterThan(tapUv, vec2(1.0)))) continue;
                float dd = texture(uDepth, tapUv).r;
                vis += (dd <= sunDepth * 1.02) ? 1.0 : 0.0;
            }
            vis /= float(TAPS);
            // Fade as the Sun leaves the frame.
            vec2 edge = min(sunUv, 1.0 - sunUv);
            vis *= smoothstep(-0.25, 0.05, min(edge.x, edge.y));
            if (visPrev >= 0.0) vis = mix(vis, visPrev, 0.92);
            visOut = vis;
            vec2 dv = (uv - sunUv) * vec2(pc.params.y, 1.0); // aspect-corrected, uv units (1 = frame height)
            float r = length(dv);

            // ---- Corona and prominences ----------------------------------------------------------
            // Always there, but only noticed once the disc is hidden (behind a planet, or Parker's heat
            // shield) or out of frame. Radial falloff from Baumbach's K-corona fit, normalised to 1 at 1.1
            // solar radii; streamers and fine rays from noise around the limb. Anything nearer than the
            // Sun at that pixel hides it.
            float rSun = r / max(radiusNdc * 0.5, 1e-12);
            if (rSun > 1.0 && rSun < 16.0 && texture(uDepth, uv + depthJ).r <= sunDepth * 1.02) {
                float ang = atan(dv.y, dv.x);
                float K = (0.0532 * pow(rSun, -2.5) + 1.425 * pow(rSun, -7.0) + 2.565 * pow(rSun, -17.0)) / 1.28;
                float streamers = pow(0.6 * angNoise(ang, 5.0, 1.7) + 0.4 * angNoise(ang, 11.0, 4.2), 2.0) * 1.8 + 0.25;
                float rays = 0.7 + 0.6 * angNoise(ang + 0.015 * rSun, 90.0, 9.1);
                float structure = mix(1.0, streamers * rays, smoothstep(1.0, 2.2, rSun));
                // The K corona is a millionth of the disc's brightness: beside a visible disc it is a trace
                // (a bright ring there would erase the darkened limb), in full once the disc is covered.
                float corona = K * structure * (0.03 + 0.97 * (1.0 - vis));
                color += vec3(1.0, 0.96, 0.9) * corona * 0.5 * pc.glare.x * 1.6;
                // Prominences: loops of hydrogen-alpha red standing a few percent of a radius off the limb.
                float promMask = smoothstep(0.6, 0.85, angNoise(ang, 36.0, 3.3)) * smoothstep(0.35, 0.7, angNoise(ang, 7.0, 8.8));
                float promHeight = 0.025 + 0.06 * angNoise(ang, 60.0, 5.5);
                float prom = promMask * (1.0 - smoothstep(0.0, promHeight, rSun - 1.0));
                // Only seen in white light when the disc itself is covered, as at totality.
                color += vec3(1.0, 0.22, 0.12) * prom * 0.75 * pc.glare.x * (1.0 - vis);
            }

            if (vis > 0.001) {
                float halo = 1.0 / (1.0 + pow(r / 0.11, 2.2));
                float wide = 0.18 / (1.0 + pow(r / 0.9, 2.0));
                vec3 tint = mix(vec3(1.0, 0.92, 0.8), vec3(0.85, 0.9, 1.0), clamp(r * 1.5, 0.0, 1.0));
                // Scattered light around the disc, not on top of it (that washed the granulation out).
                float offDisc = smoothstep(0.9, 1.3, rSun);
                color += tint * pc.glare.x * vis * (halo * 2.2 + wide) * offDisc;
                // Lens ghosts: images of the aperture reflected between lens elements, strung along the line
                // from the Sun through the frame centre, so they swing opposite the Sun as it moves.
                vec2 axis = sunUv - 0.5;
                const float gk[5] = float[5](-0.35, -0.7, -1.15, 0.4, -1.6);
                const float gs[5] = float[5](0.018, 0.045, 0.09, 0.012, 0.16);
                const vec3 gc[5] = vec3[5](vec3(0.6, 1.0, 0.7), vec3(0.5, 0.6, 1.0), vec3(0.9, 0.6, 1.0),
                                           vec3(1.0, 0.7, 0.4), vec3(0.4, 0.8, 1.0));
                vec3 ghosts = vec3(0.0);
                for (int i = 0; i < 5; ++i) {
                    float d = length((uv - (0.5 + axis * gk[i])) * vec2(pc.params.y, 1.0));
                    float disc = 1.0 - smoothstep(gs[i] * 0.7, gs[i], d);
                    float rx = (d - gs[i] * 0.92) / (gs[i] * 0.08);
                    float ring = exp(-rx * rx); // (pow of a negative base is NaN)
                    ghosts += gc[i] * (disc * 0.5 + ring * 0.6) / (1.0 + 30.0 * gs[i]);
                }
                color += ghosts * 0.04 * pc.glare.x * vis;
            }
        }
    }
    // One NaN or Inf pixel would live on in the history for good (and tonemap to black): drop it here.
    // A range test, not isnan(), which fast-math compilers may fold away.
    if (!all(lessThan(abs(resolved), vec3(6e4)))) resolved = vec3(0.0);
    if (!all(lessThan(abs(color), vec3(6e4)))) color = vec3(0.0);
    imageStore(uHistoryOut, gid, vec4(resolved, visOut));
    imageStore(uOut, gid, vec4(color, 1.0));
}
